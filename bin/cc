#!/bin/sh
# cc [name] [extra claude args...]
# Launch Claude Code inside a named tmux session so Clawd Deck can embed it
# in the browser. With no name, uses the current directory's name plus a
# time suffix. Re-running with an existing name reattaches instead of
# starting a second copy.
if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux is not installed. Install it with:"
  echo "  brew install tmux"
  exit 1
fi

name="$1"
if [ -n "$name" ]; then
  shift
else
  name="$(basename "$PWD")-$(date +%H%M%S)"
fi

# mouse on + wheel bindings: the wheel scrolls tmux history (readable, no
# selection highlight) in a terminal tab and in the dashboard's embedded view
# alike, instead of reaching claude as prompt-history cycling
# classic renderer: claude's fullscreen default (new accounts) has no terminal
# scrollback, so sessions would not scroll here or in the dashboard
exec tmux new-session -A -s "cc-$name" "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1 claude -n \"$name\" $*" \
  \; set-option mouse on \
  \; bind-key -T root WheelUpPane if-shell -F -t = '#{alternate_on}' 'send-keys -M' 'copy-mode -e ; send-keys -M' \
  \; bind-key -T root WheelDownPane if-shell -F -t = '#{alternate_on}' 'send-keys -M' ''
